{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
"paths": {
  "@/*": ["./src/*"],
  "@/app/*": ["./app/*"],
  "@/assets/*": ["./assets/*"],
  "@/components/*": ["./src/components/*"],
  "@/constants/*": ["./src/constants/*"],
  "@/hooks/*": ["./src/hooks/*"],
  "@/services/*": ["./src/services/*"]
}
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src",
    "app"
  ]
}